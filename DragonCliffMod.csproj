<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 龙崖是 Unity 5.6.6 + .NET 3.5 (CLR 2.0.50727)，插件必须 target net35 -->
    <TargetFramework>net35</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DragonCliffMod</AssemblyName>
    <RootNamespace>DragonCliffMod</RootNamespace>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- 游戏根目录，改这一处即可（注意保留结尾无斜杠） -->
    <DragonCliffDir>F:\Tool\steam\steamapps\common\Dragon Cliff</DragonCliffDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- 让 dotnet build 在没有装 .NET Framework 3.5 开发包时也能编译 net35 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- HarmonyX 用 NuGet（编译期 API 明确，运行时由 BepInEx core 提供 0Harmony） -->
    <PackageReference Include="HarmonyX" Version="2.16.0" />
  </ItemGroup>

  <!-- BepInEx 核心（引用游戏目录自带，版本绝对匹配运行时） -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(DragonCliffDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 龙崖游戏 DLL -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DragonCliffDir)\game_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(DragonCliffDir)\game_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(DragonCliffDir)\game_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(DragonCliffDir)\game_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZeroFormatter">
      <HintPath>$(DragonCliffDir)\game_Data\Managed\ZeroFormatter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZeroFormatter.Interfaces">
      <HintPath>$(DragonCliffDir)\game_Data\Managed\ZeroFormatter.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>